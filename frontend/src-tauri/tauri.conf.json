{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeMemory",
  "version": "0.1.0",
  "identifier": "com.codememory.app",
  "build": {
    "frontendDist": "../.next",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run sidecar:build"
  },
  "app": {
    "windows": [
      {
        "title": "CodeMemory",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:3000 tauri: ws: wss: 'unsafe-eval' 'unsafe-inline' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../../dist/codememory-api.exe"]
  }
}
