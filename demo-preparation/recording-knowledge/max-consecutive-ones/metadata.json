          "attempt_id": "ffbbb1fe-4af6-4270-9ffe-971007d8f4ee",
          "code": "class Solution {\n    public int findMaxConsecutiveOnes(int[] nums) {\n        int maxOnes = 0, tempOnes = 0;\n        int n = nums.length;\n\n        for(int i = 0; i < n; i++){\n            if(nums[i] == 1) tempOnes++;\n            else tempOnes = 0;\n\n            maxOnes = Math.max(maxOnes, tempOnes);\n        }\n\n        return maxOnes;\n    }\n}",
