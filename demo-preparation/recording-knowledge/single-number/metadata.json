          "code": "class Solution {\n    public int singleNumber(int[] nums) {\n        int xor = 0;\n        int n = nums.length;\n\n        for(int i = 0; i < n; i++ ){\n            xor = xor ^ nums[i];\n        }\n\n        return xor;\n    }\n}",
