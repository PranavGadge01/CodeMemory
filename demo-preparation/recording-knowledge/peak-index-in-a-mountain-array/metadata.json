          "code": "class Solution {\n    public int peakIndexInMountainArray(int[] nums) {\n        int l = 0;\n        int h = nums.length - 1;\n\n        while (l < h) {\n            int mid = l + (h - l) / 2;\n\n            if (nums[mid] < nums[mid + 1]) {\n                l = mid + 1;\n            } else {\n                h = mid;\n            }\n        }\n        return h;\n    }\n}",
