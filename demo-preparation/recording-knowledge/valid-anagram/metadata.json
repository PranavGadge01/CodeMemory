        {
          "id": "leetcode_1954811776",
          "problem_id": "ae5b3712-ebf0-4a14-9eaf-2736c435ad12",
          "attempt_id": "6e94faf7-dde2-421c-84ec-46f757b45d3b",
          "code": "class Solution {\n    public boolean isAnagram(String s, String t) {\n        if(s.length() != t.length()) return false;\n\n        int[] counts = new int[26];\n\n        for(int i = 0; i < s.length(); i++){\n            counts[s.charAt(i) - 'a']++;\n            counts[t.charAt(i) - 'a']--;\n        }\n\n        for(int c : counts){\n            if(c != 0) return false;\n        }\n\n        return true;\n    }\n}",
