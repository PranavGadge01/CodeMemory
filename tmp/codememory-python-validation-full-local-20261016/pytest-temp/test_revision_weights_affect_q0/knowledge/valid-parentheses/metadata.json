          "code": "class Solution {\n    public boolean isValid(String s) {\n        Stack<Character> stack = new Stack<>();\n        for (char c : s.toCharArray()) {\n            if (c == '(' || c == '[' || c == '{') stack.push(c);\n            else if (stack.isEmpty()) return false;\n            else if (c == ')' && stack.pop() != '(') return false;\n            else if (c == ']' && stack.pop() != '[') return false;\n            else if (c == '}' && stack.pop() != '{') return false;\n        }\n        return stack.isEmpty();\n    }\n}",
