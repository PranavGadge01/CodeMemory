          "code": "class Solution:\n    def numIslands(self, grid):\n        if not grid: return 0\n        count = 0\n        def dfs(r, c):\n            if r < 0 or c < 0 or r >= len(grid) or c >= len(grid[0]) or grid[r][c] == '0': return\n            grid[r][c] = '0'\n            for dr, dc in [(0,1),(0,-1),(1,0),(-1,0)]: dfs(r+dr, c+dc)\n        for r in range(len(grid)):\n            for c in range(len(grid[0])):\n                if grid[r][c] == '1':\n                    dfs(r, c); count += 1\n        return count",
