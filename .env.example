# CodeMemory Configuration
# Copy to .env and adjust as needed

# Storage paths (relative to project root)
CODEMEMORY_DATA_DIR=data
CODEMEMORY_KNOWLEDGE_DIR=knowledge
CODEMEMORY_DB_PATH=data/codememory.duckdb

# API server host and port
CODEMEMORY_API_HOST=127.0.0.1
CODEMEMORY_API_PORT=8000

# CORS origins for frontend/Tauri (comma-separated)
CODEMEMORY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost,http://localhost:1420

# Optional OpenAI key — if unset, CodeMemory runs 100% offline with the
# built-in heuristic AI provider.
OPENAI_API_KEY=

# AI layer toggle (true|false). Set false to force offline heuristic mode.
AI_ENABLED=true

# Embedding provider for semantic memory engine (local|openai).
# "local" uses the built-in TF-IDF engine — no API key required.
EMBEDDING_PROVIDER=local

# Log verbosity (DEBUG|INFO|WARNING|ERROR)
CODEMEMORY_LOG_LEVEL=INFO
